@model ProjectProfile
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>دسترسی محدود | پورتال اختصاصی سئو</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <style>
        body {
            font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0b1120;
            color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .lock-card {
            background-color: #1e293b;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 16px;
            padding: 40px;
            max-width: 580px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
        }
        .lock-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="lock-card">
        <div class="lock-icon">🔒</div>
        <h3 class="fw-bold text-white mb-2">دسترسی محرمانه به پورتال کارفرما</h3>
        <p class="text-white-50 small mb-4">پورتال اختصاصی دیده‌بانی سئو و کارنامه رشد «@Model.Name» (@Model.Domain)</p>

        <div class="alert alert-danger text-start p-3 mb-4 rounded-3 small border-0" style="background-color: rgba(239, 68, 68, 0.15); color: #fca5a5;">
            <strong>⚠️ وضعیت دسترسی:</strong>
            <div class="mt-1">@(ViewBag.ErrorMessage ?? "کلید دسترسی امن (Token) نامعتبر است یا ارائه نگردیده است.")</div>
        </div>

        <p class="text-white-50 small mb-4" style="line-height: 1.9;">
            اطلاعات سئو، نرخ کلیک و تحلیل کلمات کلیدی این دامنه جزو دارایی‌های محرمانه تجاری محسوب می‌گردد و مشاهده آن صرفاً با لینک رمزنگاری‌شده اختصاصی ارسالی از سوی شرکت مجاز است.
        </p>

        <div class="p-3 rounded-3 mb-4 text-start small" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="text-secondary mb-1">پشتیبانی و استعلام لینک اختصاصی:</div>
            <div class="text-white fw-bold">شرکت راهکار الکترونیک سهند • تبریز</div>
            <div class="text-info mt-1">تلفن دفتر: ۰۴۱-۳۳۳۶۰۸۵۲ • همراه: ۰۹۳۶۷۷۶۴۱۴۶</div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a href="/Account/Login" class="btn btn-outline-light btn-sm px-4">
                ورود اعضا و کارشناسان سامانه ↗
            </a>
        </div>
    </div>
</body>
</html>
