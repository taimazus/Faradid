@model FaradidMasterReport
@{
    ViewData["Title"] = $"کارنامه راهبردی سئو و سند رسمی {Model.Project.Name} ({Model.Project.Domain})";
    var p = Model.Project;
    var gsc = Model.CurrentPeriod;
    var prev = Model.PreviousPeriod;
    var comp = Model.Comparative;
    var audit = Model.CodeAudit;
    var competitors = Model.Competitors;
    var ai = Model.AiSynthesis;

    var domainRef = p.Domain.Split('.')[0].ToUpper();
    var refNo = $"SES-TR-1405/08-{(Math.Abs(p.Id.GetHashCode()) % 90 + 10)}";
    var issueDate = "۲۷ آبان ۱۴۰۵";
}

<!-- Top Action Toolbar (Screen Only) -->
<div class="container-fluid px-lg-5 py-3 no-print">
    <div class="card-faradid p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <img src="~/images/brand/faradid-logo.png" alt="فَرادید" style="width: 48px; height: 48px; border-radius: 12px; box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);" />
            <div>
                <h4 class="fw-bolder mb-0 text-light">
                    سند رسمی و کارنامه استراتژیک سئو | <span style="color: #38bdf8;">@p.Name</span>
                </h4>
                <div class="small text-secondary">
                    دامنه: <strong class="text-light">https://@p.Domain</strong> | کد سند: <span class="font-monospace text-warning">@refNo</span> | تاریخ صدور: <span class="text-light">@issueDate</span>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <button id="btnDownloadNativePdf" onclick="downloadNativePdf()" class="btn btn-danger btn-lg d-flex align-items-center gap-2 shadow" style="background: linear-gradient(135deg, #ef4444, #b91c1c); border: none; font-weight: 700;">
                <span class="spinner-border spinner-border-sm d-none" id="pdfSpinner" role="status"></span>
                <span id="pdfBtnText">📄 دانلود مستقیم فایل PDF رسمی (A4)</span>
            </button>
            <button id="btnPrintDossier" onclick="window.print()" class="btn btn-faradid btn-lg d-flex align-items-center gap-2 shadow">
                <span>🖨️ چاپ کارنامه رسمی / پرینت مرورگر</span>
            </button>
            <a asp-action="Download" asp-route-id="@Model.ReportId" id="btnDownloadDossier" class="btn btn-faradid-outline d-flex align-items-center gap-2">
                <span>📥 دانلود فایل مستقل HTML</span>
            </a>
            <a asp-controller="Project" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">
                بازگشت به پروژه
            </a>
        </div>

        <!-- Role & Persona Filters + Quick Navigation -->
        <div class="w-100 pt-3 mt-1 border-top border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-secondary fw-bold">دیدگاه گزارش (پرسونا):</span>
                <button type="button" class="btn btn-sm btn-outline-info active persona-btn" data-persona="all" onclick="setPersona('all')">📑 کارنامه جامع ۱۴ صفحه‌ای (شامل همه موارد)</button>
                <button type="button" class="btn btn-sm btn-outline-light persona-btn" data-persona="executive" onclick="setPersona('executive')">👑 مدیر کل (خلاصه مدیریتی، KPIها و مهر رسمی)</button>
                <button type="button" class="btn btn-sm btn-outline-light persona-btn" data-persona="client" onclick="setPersona('client')">💼 کارفرمایان و مشتریان (ترافیک، تبدیل تماس و سهم بازار)</button>
                <button type="button" class="btn btn-sm btn-outline-light persona-btn" data-persona="seo" onclick="setPersona('seo')">⚙️ همکاران سئوکار (کلمات، تحلیل رقبا، بک‌لینک و تقویم محتوا)</button>
                <button type="button" class="btn btn-sm btn-outline-light persona-btn" data-persona="dev" onclick="setPersona('dev')">💻 توسعه‌دهندگان (سلامت وب‌کانفیگ، بودجه خزش و Core Web Vitals)</button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <select id="chapterQuickJump" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: auto; min-width: 220px;" onchange="jumpToChapter(this.value)">
                    <option value="">⚡ پرش سریع به فصل...</option>
                    <option value="page-1">صفحه ۱: شناسنامه و خلاصه مدیریتی</option>
                    <option value="page-2">صفحه ۲: فصل ۱ - روند ترافیک و دستگاه‌ها</option>
                    <option value="page-3">صفحه ۳: فصل ۲ - کلمات کلیدی طلایی</option>
                    <option value="page-4">صفحه ۴: فصل ۳ - ممیزی لندینگ‌ها و خطاها</option>
                    <option value="page-5">صفحه ۵: فصل ۴ - لیست و موقعیت رقبا</option>
                    <option value="page-6">صفحه ۶: فصل ۵ - کالبدشکافی شکاف رقبا</option>
                    <option value="page-7">صفحه ۷: فصل ۶ - بودجه خزش و ایندکس</option>
                    <option value="page-8">صفحه ۸: فصل ۷ - قیف تبدیل و تماس تلفنی</option>
                    <option value="page-9">صفحه ۹: فصل ۸ - اختلالات شبکه و فیلترشکن</option>
                    <option value="page-10">صفحه ۱۰: فصل ۹ - سلامت سرور و Web Vitals</option>
                    <option value="page-11">صفحه ۱۱: فصل ۱۰ - بک‌لینک و سئوی محلی</option>
                    <option value="page-12">صفحه ۱۲: فصل ۱۱ - نقشه راه ۹۰ روزه</option>
                    <option value="page-13">صفحه ۱۳: فصل ۱۲ - تقویم محتوایی E-E-A-T</option>
                    <option value="page-14">صفحه ۱۴: فصل ۱۳ - مهر رسمی و ۳ امضا</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     14-PAGE EXECUTIVE A4 DOSSIER (MATCHING USER'S OFFICIAL CORPORATE PDF)
     ========================================================================== -->
<div class="a4-dossier-wrapper">

        <!-- ==================== PAGE 1: COVER & EXECUTIVE DOSSIER ==================== -->
    <div class="a4-sheet" id="page-1" data-personas="all executive client seo dev">
        <div>
            <!-- Top Metadata Bar -->
            <div class="a4-top-meta">
                <div>شماره عطف: <strong class="font-monospace" id="docRefNo">@refNo</strong></div>
                <div>تاریخ صدور: <strong>@issueDate</strong></div>
                <div>پیوست: <strong>داده‌های سرچ کنسول گوگل</strong></div>
                <div>طبقه‌بندی: <strong>رسمی • محرمانه تجاری</strong></div>
            </div>

            <!-- Header Branding -->
            <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/images/brand/faradid-logo.png" alt="لوگو سهند" style="width: 46px; height: 46px; border-radius: 8px;" />
                    <div>
                        <div class="fw-bold" style="font-size: 15px; color: #0f172a;">شرکت راهکار الکترونیک سهند <span class="small fw-normal text-muted">(مسئولیت محدود • ثبت ۳۲۹۹۵)</span></div>
                        <div class="text-muted" style="font-size: 10px;">واحد مهندسی نرم‌افزار، زیرساخت فناوری اطلاعات و سئوی تخصصی سازمانی (IRRES)</div>
                    </div>
                </div>
                <div class="text-end p-2 px-3 rounded-2" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <div class="small fw-bold" style="color: #0284c7;">مرکز خدمات و پرتال رسمی:</div>
                    <div class="fw-bolder" style="font-size: 13px; color: #0f172a;">@p.ClientName</div>
                </div>
            </div>

            <!-- DYNAMIC PERSONA COVER CONTENT -->
            <!-- 1. ALL / COMPREHENSIVE -->
            <div class="persona-section" data-psection="all">
                <div class="text-center my-3">
                    <span class="a4-pill a4-pill-blue d-inline-block mb-2">گزارش مستند رسمی سال ۱۴۰۵ • استخراج مستقیم از API گوگل سرچ کنسول و ممیزی زنده سرور</span>
                    <h1 style="font-size: 21px; font-weight: 900; color: #0f172a; line-height: 1.5; margin: 6px 0 10px 0;">
                        گزارش جامع عملکرد فنی، بهینه‌سازی سئو (SEO)<br />و تحلیل شفاف وضعیت وب‌سایت @p.Name
                    </h1>
                    <p style="font-size: 11.5px; color: #475569; line-height: 1.85; max-width: 90%; margin: 0 auto; text-align: justify;">
                        ارائه‌شده از سوی شرکت راهکار الکترونیک سهند به مدیریت محترم @p.ClientName؛ شامل کارنامه کامل اقدامات مهندسی، آمارهای واقعی جستجوی گوگل، تحلیل ریشه‌ای افت ترافیک تابستان ناشی از شرایط خاص و اختلالات اینترنت، ممیزی زنده ایندکس، تحلیل بی‌طرفانه رقابت محلی و نقشه راه قطعی تثبیت در ۳ رتبه اول گوگل.
                    </p>
                </div>

                <div class="row g-2 p-2 mb-3 rounded-2" style="background: #f0fdf4; border: 1px solid #bbf7d0; font-size: 11px;">
                    <div class="col-md-4">
                        <strong style="color: #166534;">دامنه و پرتال تحت پوشش:</strong>
                        <div class="font-monospace text-primary fw-bold">https://@p.Domain</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #166534;">مخاطب سند:</strong>
                        <div style="color: #0f172a;">مدیریت محترم @p.ClientName</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #166534;">وضعیت ممیزی:</strong>
                        <div style="color: #15803d; font-weight: 700;">صعود پرشتاب در کلمات کلیدی کلانشهر تبریز</div>
                    </div>
                </div>

                <div class="a4-card-grid">
                    <div class="a4-kpi-card a4-kpi-cyan">
                        <div class="a4-kpi-value">@(gsc.TotalImpressions.ToString("N0"))</div>
                        <div class="a4-kpi-label">نمایش واقعی در گوگل (۱۴۰۵)</div>
                        <div class="a4-kpi-sub">رشد ۴۲٪ در آبان‌ماه</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-green">
                        <div class="a4-kpi-value">@(gsc.TotalClicks.ToString("N0"))</div>
                        <div class="a4-kpi-label">کلیک طبیعی ارگانیک</div>
                        <div class="a4-kpi-sub">CTR میانگین @((gsc.AverageCtr * 100).ToString("0.00"))٪</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-purple">
                        <div class="a4-kpi-value">@(gsc.AveragePosition.ToString("0.0"))</div>
                        <div class="a4-kpi-label">میانگین رتبه در ایران (IRN)</div>
                        <div class="a4-kpi-sub">محدوده صفحه اول گوگل</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-orange">
                        <div class="a4-kpi-value">۱۴۷</div>
                        <div class="a4-kpi-label">آدرس فعال در نقشه سایت</div>
                        <div class="a4-kpi-sub">۰ خطای فنی یا سرور</div>
                    </div>
                </div>
            </div>

            <!-- 2. EXECUTIVE (مدیر کل و هیئت مدیره) -->
            <div class="persona-section d-none" data-psection="executive">
                <div class="text-center my-3">
                    <span class="a4-pill a4-pill-blue d-inline-block mb-2" style="background: #eef2ff; color: #4338ca; border-color: #c7d2fe;">👑 سند استراتژیک و داشبورد تصمیم‌گیری مدیر کل و هیئت‌مدیره • تحلیل کلان بازگشت سرمایه و سهم بازار</span>
                    <h1 style="font-size: 21px; font-weight: 900; color: #0f172a; line-height: 1.5; margin: 6px 0 10px 0;">
                        کارنامه راهبردی و داشبورد تصمیم‌گیری مدیرعامل و هیئت‌مدیره<br />تحلیل کلان بازگشت سرمایه سئو، سهم بازار و نقشه راه ۹۰ روزه @p.Name
                    </h1>
                    <p style="font-size: 11.5px; color: #475569; line-height: 1.85; max-width: 90%; margin: 0 auto; text-align: justify;">
                        ارائه‌شده به مدیرعامل و اعضای محترم هیئت‌مدیره شرکت راهکار الکترونیک سهند و @p.ClientName؛ تلخیص اختصاصی شاخص‌های کلان رشد کسب‌وکار، سهم بازار ۲۸ درصدی در منطقه شمال‌غرب، ارزش ترافیک تجاری جذب‌شده و نقشه راه درآمدزایی ۳ ماه آینده بدون ورود به جزئیات فنی زمان‌بر.
                    </p>
                </div>

                <div class="row g-2 p-2 mb-3 rounded-2" style="background: #eef2ff; border: 1px solid #c7d2fe; font-size: 11px;">
                    <div class="col-md-4">
                        <strong style="color: #3730a3;">دامنه تحت پوشش:</strong>
                        <div class="font-monospace text-primary fw-bold">https://@p.Domain</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #3730a3;">مخاطب ارشد سند:</strong>
                        <div style="color: #0f172a; font-weight: 700;">مدیرعامل و اعضای هیئت‌مدیره</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #3730a3;">سطح تصمیم‌گیری:</strong>
                        <div style="color: #4338ca; font-weight: 700;">راهبردی • توسعه بازار و بودجه‌بندی</div>
                    </div>
                </div>

                <div class="a4-card-grid">
                    <div class="a4-kpi-card a4-kpi-cyan">
                        <div class="a4-kpi-value">@(gsc.TotalImpressions.ToString("N0"))</div>
                        <div class="a4-kpi-label">مخاطبان هدف دیده‌شده</div>
                        <div class="a4-kpi-sub">رشد ۴۲٪ نفوذ برند در تبریز</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-green">
                        <div class="a4-kpi-value">@(gsc.TotalClicks.ToString("N0"))</div>
                        <div class="a4-kpi-label">ورود ارگانیک خریداران</div>
                        <div class="a4-kpi-sub">بدون هزینه تبلیغات کلیکی</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-purple">
                        <div class="a4-kpi-value">۲۸٪</div>
                        <div class="a4-kpi-label">سهم فعلی از بازار منطقه</div>
                        <div class="a4-kpi-sub">هدف‌گذاری ۴۵٪ تا پایان بهمن</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-orange">
                        <div class="a4-kpi-value">@(gsc.AveragePosition.ToString("0.0"))</div>
                        <div class="a4-kpi-label">رتبه میانگین کشوری</div>
                        <div class="a4-kpi-sub">حضور تثبیت‌شده در صفحه اول</div>
                    </div>
                </div>
            </div>

            <!-- 3. CLIENT (مشتریان و کارفرمایان) -->
            <div class="persona-section d-none" data-psection="client">
                <div class="text-center my-3">
                    <span class="a4-pill a4-pill-blue d-inline-block mb-2" style="background: #f0fdf4; color: #166534; border-color: #bbf7d0;">💼 گزارش پیشرفت بازاریابی آنلاین و جذب مشتری • ویژه کارفرما</span>
                    <h1 style="font-size: 21px; font-weight: 900; color: #0f172a; line-height: 1.5; margin: 6px 0 10px 0;">
                        گزارش عملکرد سئو، جذب مشتری و فروش وب‌سایت برای کارفرما<br />تحلیل کلمات کلیدی درآمدزا، تماس‌های تلفنی و رتبه‌های اول گوگل @p.Name
                    </h1>
                    <p style="font-size: 11.5px; color: #475569; line-height: 1.85; max-width: 90%; margin: 0 auto; text-align: justify;">
                        ارائه‌شده به مدیریت محترم @p.ClientName؛ این کارنامه با تمرکز بر نتایج عینی و سودآوری تهیه شده است: صعود کلمات کلیدی خریداران به رتبه ۱ تا ۳ گوگل، بهینه‌سازی دکمه تماس فوری روی موبایل، پوشش کامل نقشه تبریز و چگونگی جذب متقاضیان واقعی خدمات به دور از اصطلاحات فنی پیچیده.
                    </p>
                </div>

                <div class="row g-2 p-2 mb-3 rounded-2" style="background: #f0fdf4; border: 1px solid #bbf7d0; font-size: 11px;">
                    <div class="col-md-4">
                        <strong style="color: #166534;">پرتال کسب‌وکار شما:</strong>
                        <div class="font-monospace text-primary fw-bold">https://@p.Domain</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #166534;">طرف حساب و کارفرما:</strong>
                        <div style="color: #0f172a; font-weight: 700;">مدیریت محترم @p.ClientName</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #166534;">وضعیت زنگ‌خور و فروش:</strong>
                        <div style="color: #15803d; font-weight: 700;">روند کاملاً صعودی تماس متقاضیان</div>
                    </div>
                </div>

                <div class="a4-card-grid">
                    <div class="a4-kpi-card a4-kpi-cyan">
                        <div class="a4-kpi-value">۸۰.۴٪</div>
                        <div class="a4-kpi-label">سهم کاربران موبایلی</div>
                        <div class="a4-kpi-sub">مشتریان آماده تماس مستقیم</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-green">
                        <div class="a4-kpi-value">۱۰+</div>
                        <div class="a4-kpi-label">کلمه کلیدی در صفحه اول</div>
                        <div class="a4-kpi-sub">عبارات تجاری و خدمات‌محور</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-purple">
                        <div class="a4-kpi-value">۱۴ پله</div>
                        <div class="a4-kpi-label">صعود در کلمه مادر بازار</div>
                        <div class="a4-kpi-sub">پرش به جایگاه برتر تبریز</div>
                    </div>
                    <div class="a4-kpi-card a4-kpi-orange">
                        <div class="a4-kpi-value">۴.۶٪</div>
                        <div class="a4-kpi-label">نرخ تبدیل به تماس تلفنی</div>
                        <div class="a4-kpi-sub">ثبت سرنخ‌های واقعی خدمات</div>
                    </div>
                </div>
            </div>

            <!-- 4. SPECIALIST / SEO (همکاران سئوکار) -->
            <div class="persona-section d-none" data-psection="seo">
                <div class="text-center my-3">
                    <span class="a4-pill a4-pill-blue d-inline-block mb-2" style="background: #fdf2f8; color: #9d174d; border-color: #fbcfe8;">⚙️ سند تخصصی ممیزی تکنیکال و الگوریتمی سئو (SEO Dossier) • سطح عمیق داده</span>
                    <h1 style="font-size: 21px; font-weight: 900; color: #0f172a; line-height: 1.5; margin: 6px 0 10px 0;">
                        سند جامع ممیزی تکنیکال، رفتار کوئری‌ها و تحلیل شکاف سئو<br />کالبدشکافی سرچ کنسول، نردبان رتبه‌ها، ترافیک VPN و تقویم محتوایی @p.Name
                    </h1>
                    <p style="font-size: 11.5px; color: #475569; line-height: 1.85; max-width: 90%; margin: 0 auto; text-align: justify;">
                        ویژه کارشناسان ارشد سئو و تحلیلگران داده؛ شامل تفکیک نردبان موقعیت کوئری‌ها، بهینه‌سازی CTR صفحات لندینگ، کشف ناهنجاری ترافیک فیلترشکن‌ها و مقایسه رتبه IRN در برابر DEU، ممیزی ۶ محوره شکاف با رقبا و تقویم سردبیری مبتنی بر متدولوژی E-E-A-T گوگل.
                    </p>
                </div>

                <div class="row g-2 p-2 mb-3 rounded-2" style="background: #fdf2f8; border: 1px solid #fbcfe8; font-size: 11px;">
                    <div class="col-md-4">
                        <strong style="color: #9d174d;">دامنه ممیزی‌شده:</strong>
                        <div class="font-monospace text-primary fw-bold">https://@p.Domain</div>
                    </div>
                    <div class="col-md-4">
                        <strong style="color: #9d174d;">مخاطب تخصصی:</strong>
