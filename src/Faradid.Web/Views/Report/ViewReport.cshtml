</div>

@section Scripts {
<script src="~/lib/html2pdf/html2pdf.bundle.min.js"></script>
<script>
    let currentPersona = 'all';

    async function downloadNativePdf() {
        const btn = document.getElementById('btnDownloadNativePdf');
        const spinner = document.getElementById('pdfSpinner');
        const btnText = document.getElementById('pdfBtnText');

        try {
            btn.classList.add('disabled');
            spinner.classList.remove('d-none');
            btnText.textContent = 'درحال آماده‌سازی و رندر فایل PDF...';

            // Select active visible sheets
            const activeSheets = Array.from(document.querySelectorAll('.a4-sheet')).filter(s => s.style.display !== 'none' && !s.classList.contains('persona-hidden'));
            
            // Build temporary A4 print stage
            const stage = document.createElement('div');
            stage.id = 'pdf-render-stage';
            stage.style.width = '210mm';
            stage.style.margin = '0 auto';
            stage.style.background = '#ffffff';
            stage.style.direction = 'rtl';

            activeSheets.forEach((sheet, idx) => {
                const clone = sheet.cloneNode(true);
                clone.style.width = '210mm';
                clone.style.minHeight = '297mm';
                clone.style.height = 'auto';
                clone.style.boxShadow = 'none';
                clone.style.border = 'none';
                clone.style.margin = '0';
                clone.style.boxSizing = 'border-box';
                clone.style.pageBreakAfter = (idx < activeSheets.length - 1) ? 'always' : 'auto';
                clone.style.breakAfter = (idx < activeSheets.length - 1) ? 'page' : 'auto';
                stage.appendChild(clone);
            });

            const cleanDomain = '@Model.Project.Domain'.replace(/\./g, '-');
            const filename = `Faradid-Official-Report-${cleanDomain}-${currentPersona}.pdf`;

            const opt = {
                margin: [0, 0, 0, 0],
                filename: filename,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    letterRendering: true,
                    backgroundColor: '#ffffff'
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            await html2pdf().set(opt).from(stage).save();

            btnText.textContent = '✅ فایل PDF با موفقیت دانلود شد';
            setTimeout(() => {
                btnText.textContent = '📄 دانلود مستقیم فایل PDF رسمی (A4)';
                btn.classList.remove('disabled');
                spinner.classList.add('d-none');
            }, 3000);
        } catch (err) {
            console.error('Error in PDF generation:', err);
            alert('تولید PDF با خطا مواجه شد: ' + err.message + '\nمی‌توانید از دکمه «چاپ کارنامه رسمی / پرینت مرورگر» استفاده فرمایید.');
            btnText.textContent = '📄 دانلود مستقیم فایل PDF رسمی (A4)';
            btn.classList.remove('disabled');
            spinner.classList.add('d-none');
        }
    }

<script>
    const personaConfigs = {
        'all': {
            label: 'کارنامه جامع سازمانی (سند ۱۴ صفحه‌ای کامل)',
            printTitle: '🖨️ چاپ کارنامه جامع سازمانی (سند ۱۴ صفحه‌ای کامل)',
            refSuffix: 'ALL',
            pages: ['page-1', 'page-2', 'page-3', 'page-4', 'page-5', 'page-6', 'page-7', 'page-8', 'page-9', 'page-10', 'page-11', 'page-12', 'page-13', 'page-14']
        },
        'executive': {
            label: 'کارنامه راهبردی مدیر کل و هیئت‌مدیره (سند ۵ صفحه‌ای)',
            printTitle: '🖨️ چاپ کارنامه مدیر کل و هیئت‌مدیره (سند ۵ صفحه‌ای رسمی)',
            refSuffix: 'EX',
            pages: ['page-1', 'page-2', 'page-5', 'page-12', 'page-14']
        },
        'client': {
            label: 'گزارش پیشرفت بازاریابی و فروش کارفرما (سند ۵ صفحه‌ای)',
            printTitle: '🖨️ چاپ کارنامه کارفرما و فروش (سند ۵ صفحه‌ای اختصاصی)',
            refSuffix: 'CL',
            pages: ['page-1', 'page-3', 'page-8', 'page-11', 'page-14']
        },
        'seo': {
            label: 'سند تخصصی و الگوریتمی سئوکاران (سند ۷ صفحه‌ای)',
            printTitle: '🖨️ چاپ کارنامه تخصصی سئوکاران (سند ۷ صفحه‌ای تحلیلی)',
            refSuffix: 'SEO',
            pages: ['page-1', 'page-2', 'page-3', 'page-4', 'page-6', 'page-9', 'page-13']
        },
        'dev': {
            label: 'سند ممیزی کدهای محلی و وب‌سرور توسعه‌دهندگان (سند ۵ صفحه‌ای)',
            printTitle: '🖨️ چاپ کارنامه فنی توسعه‌دهندگان (سند ۵ صفحه‌ای مهندسی)',
            refSuffix: 'DEV',
            pages: ['page-1', 'page-4', 'page-7', 'page-10', 'page-12']
        }
    };

    function setPersona(persona) {
        currentPersona = persona;
        if (!personaConfigs[persona]) persona = 'all';
        const config = personaConfigs[persona];

        // 1. Update button states
        document.querySelectorAll('.persona-btn').forEach(b => {
            if (b.getAttribute('data-persona') === persona) {
                b.classList.remove('btn-outline-light');
                b.classList.add('btn-outline-info', 'active');
            } else {
                b.classList.remove('btn-outline-info', 'active');
                b.classList.add('btn-outline-light');
            }
        });

        // 2. Update print button text
        const printBtn = document.getElementById('btnPrintDossier');
        if (printBtn) {
            printBtn.querySelector('span').textContent = config.printTitle;
        }

        // 3. Update download link query param
        const downloadBtn = document.getElementById('btnDownloadDossier');
        if (downloadBtn) {
            const baseUrl = downloadBtn.getAttribute('href').split('?')[0];
            downloadBtn.setAttribute('href', baseUrl + '?persona=' + persona);
        }

        // 4. Update Page 1 dynamic cover section
        document.querySelectorAll('.persona-section').forEach(sec => {
            if (sec.getAttribute('data-psection') === persona) {
                sec.classList.remove('d-none');
            } else {
                sec.classList.add('d-none');
            }
        });

        // 5. Update document ref number suffix
        const docRef = document.getElementById('docRefNo');
        if (docRef) {
            const rawRef = docRef.getAttribute('data-raw') || docRef.textContent;
            docRef.setAttribute('data-raw', rawRef);
            const baseRef = rawRef.split('-')[0] + '-' + rawRef.split('-')[1];
            docRef.textContent = baseRef + '-' + config.refSuffix;
        }

        // 6. Filter sheets and recalculate page numbers
        const targetPages = config.pages;
        const totalTargetPages = targetPages.length;

        document.querySelectorAll('.a4-sheet').forEach(sheet => {
            const pid = sheet.id;
            const idx = targetPages.indexOf(pid);

            if (idx !== -1) {
                sheet.style.display = 'flex';
                sheet.classList.remove('persona-hidden');
                
                // Update footer page number
                const footerIndicator = sheet.querySelector('.page-num-indicator');
                if (footerIndicator) {
                    footerIndicator.textContent = `صفحه ${idx + 1} از ${totalTargetPages}`;
                }
            } else {
                sheet.style.display = 'none';
                sheet.classList.add('persona-hidden');
            }
        });

        // Smoothly scroll back to top of dossier
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function jumpToChapter(pageId) {
        if (!pageId) return;
        const el = document.getElementById(pageId);
        if (el) {
            // Ensure visible even if filtered out
            el.style.display = 'flex';
            el.classList.remove('persona-hidden');
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Auto-detect URL query parameter or default
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const personaParam = urlParams.get('persona') || '@(ViewBag.ActivePersona ?? "all")';
        if (personaParam && personaConfigs[personaParam.toLowerCase()]) {
            setPersona(personaParam.toLowerCase());
        } else {
            setPersona('all');
        }
    });
</script>
}
