@model ProjectProfile
@{
    ViewData["Title"] = $"دیده‌بانی {Model.Name} ({Model.Domain})";
    var reports = ViewBag.Reports as IReadOnlyList<FaradidMasterReport> ?? Array.Empty<FaradidMasterReport>();
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h2 class="fw-bold mb-0">@Model.Name</h2>
                <span class="badge bg-primary fs-6">@Model.Domain</span>
            </div>
            <p class="text-secondary small mb-0 mt-1">کارفرما: @Model.ClientName | صنعت: @Model.Industry</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-faradid-outline">بازگشت به فهرست پروژه‌ها</a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Project Summary Card -->
        <div class="col-lg-4">
            <div class="card-faradid p-4 h-100">
                <h5 class="fw-bold mb-3 border-end border-3 border-danger pe-2">شناسنامه پروژه</h5>
                <ul class="list-unstyled small mb-4">
                    <li class="mb-2 d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary">دامنه وب‌سایت:</span>
                        <a href="https://@Model.Domain" target="_blank" class="fw-bold text-decoration-none" style="color: #00e5ff;">@Model.Domain ↗</a>
                    </li>
                    <li class="mb-2 d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary">کارفرما / ذینفع:</span>
                        <span class="text-light fw-semibold">@Model.ClientName</span>
                    </li>
                    <li class="mb-2 d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary">حوزه تخصصی:</span>
                        <span class="text-light">@Model.Industry</span>
                    </li>
                    <li class="mb-2 border-bottom border-secondary pb-2">
                        <div class="text-secondary mb-1">مسیر سورس‌کد محلی:</div>
                        <div class="font-monospace small text-info" style="word-break: break-all;">
                            @(string.IsNullOrWhiteSpace(Model.LocalSourcePath) ? "تعریف‌نشده" : Model.LocalSourcePath)
                        </div>
                    </li>
                    <li class="mb-2 border-bottom border-secondary pb-2">
                        <div class="text-secondary mb-1">مسیر صدور کارنامه‌ها:</div>
                        <div class="font-monospace small text-warning" style="word-break: break-all;">
                            @(string.IsNullOrWhiteSpace(Model.TargetReportPath) ? "پیش‌فرض سامانه" : Model.TargetReportPath)
                        </div>
                    </li>
                    <li class="mb-2 d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary">سرویس سرچ کنسول:</span>
                        <span class="badge bg-success-subtle text-success">Google API Sync 🟢</span>
                    </li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--brand-border);">
                        <div class="small fw-bold text-secondary mb-1">یادداشت استراتژیک:</div>
                        <div class="small text-light">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <!-- Run Audit & Generation Card -->
        <div class="col-lg-8">
            <!-- Google Search Console API Realtime Integration Banner -->
            <div class="card-faradid p-4 mb-4" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(0, 229, 255, 0.04)); border: 1px solid rgba(16, 185, 129, 0.3);">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-1 text-success">🔄</div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0 text-light">اتصال مستقیم به Google Search Console API</h5>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 11px;">متصل و زمان‌بندی‌شده 🟢</span>
                            </div>
                            <div class="small text-secondary mt-1">
                                همگام‌سازی مستقیم از طریق API رسمی گوگل • بدون نیاز به دانلود دستی فایل CSV • صدور خودکار ماهانه
                            </div>
                        </div>
                    </div>
                    <form asp-action="SyncGscApi" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success d-flex align-items-center gap-2 shadow">
                            <span>⚡ همگام‌سازی زنده با سرچ کنسول گوگل (API Sync)</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="card-faradid p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="fs-1">⚡</div>
                    <div>
                        <h4 class="fw-bold mb-1">صدور و استخراج کارنامه جامع فَرادید</h4>
                        <p class="text-secondary small mb-0">دیده‌بانی بلادرنگ داده‌های سرچ کنسول، تحلیل شکاف ۶ گانه با رقبا و ممیزی کدهای محلی</p>
                    </div>
                </div>

                <form asp-action="GenerateReport" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">دیدگاه پیش‌فرض کارنامه (Persona)</label>
                            <select name="persona" class="form-select bg-dark text-light border-secondary">
                                <option value="Executive" selected>👑 هیئت مدیره و مدیرعامل (Executive)</option>
                                <option value="Client">💼 کارفرما و ذینفع کسب‌وکار (Client)</option>
                                <option value="Specialist">⚙️ کارشناس ارشد سئو و فنی (Specialist)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">منبع داده‌های سرچ کنسول (GSC)</label>
                            <select class="form-select bg-dark text-light border-secondary" id="dataSourceSelect">
                                <option value="preset" selected>داده‌های پیشرفته سرچ کنسول دامنه (شامل ناهنجاری VPN آلمان)</option>
                                <option value="custom">ورود دستی یا بارگذاری فایل CSV سرچ کنسول</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4" id="csvInputGroup" style="display: none;">
                        <label class="form-label fw-bold small">محتوای متنی فایل CSV خروجی سرچ کنسول</label>
                        <textarea name="gscCsvContent" rows="4" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="Query,Clicks,Impressions,CTR,Position..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-faradid btn-lg px-5 d-flex align-items-center gap-2">
                            <span>🚀 اجرای تحلیل و صدور کارنامه</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Past Reports History -->
    <div class="card-faradid p-4">
        <h5 class="fw-bold mb-3 border-end border-3 border-danger pe-2">تاریخچه کارنامه‌های صادرشده برای @Model.Domain</h5>
        @if (reports.Count == 0)
        {
            <div class="text-center py-5 text-secondary">
                <div class="fs-1 mb-2">📄</div>
                <div>هنوز کارنامه‌ای برای این پروژه صادر نشده است. بر روی دکمه «اجرای تحلیل و صدور کارنامه» در بالا کلیک کنید.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent;">
                    <thead>
                        <tr class="text-secondary small border-bottom border-secondary">
                            <th>شناسه کارنامه</th>
                            <th>تاریخ صدور</th>
                            <th>کلیک‌ها</th>
                            <th>ایمپرشن</th>
                            <th>سلامت کد محلی</th>
                            <th>دیدگاه فعال</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in reports)
                        {
                            <tr>
                                <td class="font-monospace small">@r.ReportId.ToString().Substring(0, 8)...</td>
                                <td>@r.GeneratedAtUtc.ToLocalTime().ToString("yyyy/MM/dd - HH:mm")</td>
                                <td class="fw-bold" style="color: #00e5ff;">@r.CurrentPeriod.TotalClicks.ToString("N0")</td>
                                <td>@r.CurrentPeriod.TotalImpressions.ToString("N0")</td>
                                <td>
                                    <span class="badge @(r.CodeAudit?.TechnicalHealthScore >= 80 ? "bg-success" : "bg-warning")">
                                        @(r.CodeAudit?.TechnicalHealthScore ?? 85)/100
                                    </span>
                                </td>
                                <td><span class="badge bg-secondary">@r.ActivePersona</span></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-controller="Report" asp-action="ViewReport" asp-route-id="@r.ReportId" class="btn btn-sm btn-faradid">
                                            مشاهده کارنامه هوشمند 👁️
                                        </a>
                                        <a asp-controller="Report" asp-action="Download" asp-route-id="@r.ReportId" class="btn btn-sm btn-faradid-outline">
                                            دانلود HTML 📥
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('dataSourceSelect').addEventListener('change', function() {
            var csvGroup = document.getElementById('csvInputGroup');
            if (this.value === 'custom') {
                csvGroup.style.display = 'block';
            } else {
                csvGroup.style.display = 'none';
            }
        });
    </script>
}
