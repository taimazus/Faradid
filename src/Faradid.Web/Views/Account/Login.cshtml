@using Faradid.Web.Authentication
@{
    ViewData["Title"] = "ورود به سامانه دیده‌بانی فَرادید";
    var config = ViewBag.Config as CentralAuthConfig ?? new CentralAuthConfig();
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container py-5" style="max-width: 540px;">
    <div class="card-faradid p-4 p-md-5 text-center">
        <div class="mb-4">
            <img src="~/images/brand/faradid-logo.png" alt="فَرادید" style="width: 80px; height: 80px; border-radius: 18px; box-shadow: 0 0 25px rgba(0, 229, 255, 0.4);" />
            <h3 class="fw-bold mt-3 mb-1">ورود به سامانه فَرادید</h3>
            <p class="text-secondary small">احراز هویت متمرکز راهکار الکترونیک سهند (Irres Gate)</p>
        </div>

        <div class="alert alert-info text-start small mb-4" style="background-color: rgba(6, 182, 212, 0.1); border-color: rgba(6, 182, 212, 0.3); color: #a5f3fc;">
            🔒 دسترسی به پیشخوان دیده‌بانی و اطلاعات کارنامه‌ها نیازمند تایید هویت در سرور مرکزی احراز هویت سهند (<code style="color: #ffffff;">@config.Authority</code>) می‌باشد.
        </div>

        <form asp-action="SsoRedirect" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-faradid btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                <span>🔐 ورود با سامانه هویت مرکزی سهند</span>
            </button>
        </form>

        @if (config.AllowLocalBypass)
        {
            <div class="border-top border-secondary pt-3 mt-4 text-start">
                <div class="small text-secondary mb-2">⚡ ورود مستقیم حالت توسعه و کارشناس سئو:</div>
                <form asp-action="DevBypassLogin" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="text" name="username" class="form-control form-control-sm bg-dark text-light border-secondary" value="کارشناس ارشد سئو (سهند)" />
                    <button type="submit" class="btn btn-sm btn-faradid-outline text-nowrap">ورود تستی</button>
                </form>
            </div>
        }
    </div>
</div>
