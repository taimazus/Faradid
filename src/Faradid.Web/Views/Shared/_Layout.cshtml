<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - فَرادید (Faradid) | سامانه هوشمند دیده‌بانی سئو</title>
    
    <!-- 1. Local Vazirmatn Font (Zero CDN Dependency) -->
    <link rel="stylesheet" href="~/css/vazirmatn.css" asp-append-version="true" />
    
    <!-- 2. Local Bootstrap 5.3 RTL (Zero CDN Dependency) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    
    <!-- 3. Local Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- 4. Local Chart.js -->
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>

    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />

    <style>
        :root {
            --brand-primary: #9e1b32;
            --brand-primary-hover: #b91c38;
            --brand-accent: #00e5ff;
            --brand-bg: #0b0f19;
            --brand-surface: #111827;
            --brand-card: #162032;
            --brand-border: #223049;
            --brand-text: #f8fafc;
            --brand-muted: #94a3b8;
        }

        /* Robust Reset and Core Styling */
        * {
            box-sizing: border-box;
            font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: var(--brand-bg);
            color: var(--brand-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
            direction: rtl;
            text-align: right;
        }

        /* Navbar */
        .navbar-faradid {
            background-color: #0f172a;
            border-bottom: 1px solid var(--brand-border);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .brand-badge-logo {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            object-fit: contain;
            background: transparent;
            filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.4));
        }

        .brand-text-title {
            font-size: 20px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .brand-text-highlight {
            color: #ef4444;
        }

        .nav-link {
            font-weight: 500;
            color: #cbd5e1 !important;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(158, 27, 50, 0.25);
        }

        /* Cards */
        .card-faradid {
            background-color: var(--brand-card);
            border: 1px solid var(--brand-border);
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card-faradid:hover {
            border-color: #3b82f6;
        }

        /* Buttons */
        .btn-faradid {
            background-color: var(--brand-primary);
            color: #ffffff !important;
            border: none;
            font-weight: 700;
            padding: 10px 22px;
            border-radius: 8px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-faradid:hover {
            background-color: var(--brand-primary-hover);
            box-shadow: 0 0 16px rgba(158, 27, 50, 0.6);
        }

        .btn-faradid-outline {
            background: transparent;
            color: var(--brand-text) !important;
            border: 1px solid var(--brand-border);
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-faradid-outline:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: #64748b;
        }

        /* Footer */
        .footer-faradid {
            margin-top: auto;
            border-top: 1px solid var(--brand-border);
            background-color: var(--brand-surface);
            padding: 24px 0;
            font-size: 13px;
            color: var(--brand-muted);
        }

        /* Persona Switcher Tabs */
        .persona-pill {
            cursor: pointer;
            padding: 8px 18px;
            border-radius: 10px;
            border: 1px solid var(--brand-border);
            background-color: var(--brand-surface);
            color: var(--brand-muted) !important;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .persona-pill.active {
            background-color: var(--brand-primary);
            color: #ffffff !important;
            border-color: var(--brand-primary);
            box-shadow: 0 0 12px rgba(158, 27, 50, 0.5);
        }

        /* Hero Image Fix */
        .hero-logo-box {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-logo-img {
            max-width: 240px;
            height: auto;
            border-radius: 24px;
            filter: drop-shadow(0 0 25px rgba(0, 229, 255, 0.45));
            background: transparent;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-faradid">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand d-flex align-items-center gap-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <img src="~/images/brand/faradid-logo.png" alt="فَرادید" class="brand-badge-logo" />
                    <div>
                        <div class="brand-text-title">فَرا<span class="brand-text-highlight">دید</span></div>
                        <div style="font-size: 11px; color: var(--brand-muted);">سامانه هوشمند دیده‌بانی سئو</div>
                    </div>
                </a>

                <button class="navbar-toggler text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">پیشخوان کاربری</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Project" asp-action="Index">@(Faradid.Web.Authentication.UserAccessHelper.IsAdmin(User) ? "همه پروژه‌ها" : "پروژه‌های من")</a>
                            </li>
                            @if (Faradid.Web.Authentication.UserAccessHelper.IsAdmin(User))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Project" asp-action="Create">ثبت پروژه جدید</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">درباره سامانه</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isAdmin = Faradid.Web.Authentication.UserAccessHelper.IsAdmin(User);
                            <div class="dropdown">
                                <button class="btn btn-faradid-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <span class="badge @(isAdmin ? "bg-danger" : "bg-info") rounded-circle" style="width: 8px; height: 8px; padding: 0;"> </span>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge @(isAdmin ? "bg-danger" : "bg-info text-dark")" style="font-size: 10px;">@(isAdmin ? "مدیر کل" : "کارفرما")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" style="background-color: var(--brand-card); border-color: var(--brand-border);">
                                    <li class="px-3 py-2 border-bottom border-secondary">
                                        <div class="small fw-bold text-light">@User.Identity.Name</div>
                                        <div class="small text-secondary" style="font-size: 11px;">@(isAdmin ? "سطح دسترسی: نظارت و ممیزی نامحدود" : "سطح دسترسی: کارفرمای اختصاصی")</div>
                                    </li>
                                    <li><a class="dropdown-item text-light py-2" asp-controller="Project" asp-action="Index">@(isAdmin ? "مدیریت پروژه‌ها" : "مشاهده کارنامه‌های من")</a></li>
                                    <li><hr class="dropdown-divider border-secondary" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2 w-100 text-start">خروج از حساب کاربری ↩</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-faradid">ورود به سامانه (Irres Gate)</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container-fluid px-lg-5 pt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: rgba(16, 185, 129, 0.15); border-color: #10b981; color: #a7f3d0;">
                    <strong>عملیات موفق:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container-fluid px-lg-5 pt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background-color: rgba(239, 68, 68, 0.15); border-color: #ef4444; color: #fca5a5;">
                    <strong>خطا:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-faradid">
        <div class="container-fluid px-lg-5">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <div><strong>فَرادید (Faradid)</strong> | سامانه جامع دیده‌بانی سئو، ممیزی کدهای محلی و تحلیل داده‌های سرچ کنسول</div>
                    <div style="font-size: 11px; margin-top: 4px;">طراحی و پیاده‌سازی شده بر بستر ASP.NET Core 10 | راهکار الکترونیک سهند</div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-secondary">نسخه ۱.۰.۰ سازمانی (.NET 10)</span>
                    <span class="badge bg-primary ms-2">faradid.irres.ir</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Local Bootstrap 5.3 JS Bundle (Zero CDN Dependency) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
