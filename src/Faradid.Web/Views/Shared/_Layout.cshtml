<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - فَرادید (Faradid) | سامانه هوشمند دیده‌بانی سئو</title>
    
    <!-- Vazirmatn Google/CDN Font -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    
    <!-- Bootstrap 5.3 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" integrity="sha384-dpuaG1suU0eT09tx5plTaGMLBsfDLzUUCIEKYo864SZ34z5dJ2Rm0AF55j1z3Z5q" crossorigin="anonymous" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <link rel="icon" type="image/png" href="~/favicon.png" />

    <style>
        :root {
            --brand-primary: #9e1b32;
            --brand-primary-hover: #b91c38;
            --brand-accent: #00e5ff;
            --brand-bg: #0b0f19;
            --brand-surface: #111827;
            --brand-card: #1a2234;
            --brand-border: #28354f;
            --brand-text: #f3f4f6;
            --brand-muted: #94a3b8;
        }

        body {
            font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--brand-bg);
            color: var(--brand-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-faradid {
            background-color: rgba(17, 24, 39, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--brand-border);
            padding: 12px 0;
        }

        .brand-badge-logo {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
        }

        .brand-text-title {
            font-size: 20px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .brand-text-highlight {
            color: var(--brand-primary);
        }

        .nav-link {
            font-weight: 500;
            color: #cbd5e1 !important;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(158, 27, 50, 0.2);
        }

        .card-faradid {
            background-color: var(--brand-card);
            border: 1px solid var(--brand-border);
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card-faradid:hover {
            border-color: #3b82f6;
        }

        .btn-faradid {
            background-color: var(--brand-primary);
            color: #ffffff;
            border: none;
            font-weight: 700;
            padding: 10px 22px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .btn-faradid:hover {
            background-color: var(--brand-primary-hover);
            color: #ffffff;
            box-shadow: 0 0 16px rgba(158, 27, 50, 0.5);
        }

        .btn-faradid-outline {
            background: transparent;
            color: var(--brand-text);
            border: 1px solid var(--brand-border);
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .btn-faradid-outline:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: #64748b;
            color: #ffffff;
        }

        .footer-faradid {
            margin-top: auto;
            border-top: 1px solid var(--brand-border);
            background-color: var(--brand-surface);
            padding: 24px 0;
            font-size: 13px;
            color: var(--brand-muted);
        }

        /* Persona Switcher Tabs */
        .persona-pill {
            cursor: pointer;
            padding: 10px 20px;
            border-radius: 10px;
            border: 1px solid var(--brand-border);
            background-color: var(--brand-surface);
            color: var(--brand-muted);
            font-weight: 600;
            transition: all 0.2s;
            text-decoration: none;
        }

        .persona-pill.active {
            background-color: var(--brand-primary);
            color: #ffffff;
            border-color: var(--brand-primary);
            box-shadow: 0 0 12px rgba(158, 27, 50, 0.4);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-faradid sticky-top">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/brand/faradid-logo.png" alt="فَرادید" class="brand-badge-logo" />
                    <div>
                        <div class="brand-text-title">فَرا<span class="brand-text-highlight">دید</span></div>
                        <div style="font-size: 11px; color: var(--brand-muted);">سامانه هوشمند دیده‌بانی سئو</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">پیشخوان اصلی</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Project" asp-action="Index">پروژه‌های دیده‌بانی</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Project" asp-action="Create">ثبت پروژه جدید</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">درباره سامانه</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-faradid-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <span class="badge bg-success rounded-circle" style="width: 8px; height: 8px; padding: 0;"> </span>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" style="background-color: var(--brand-card); border-color: var(--brand-border);">
                                    <li><a class="dropdown-item text-light" asp-controller="Project" asp-action="Index">لیست پروژه‌ها</a></li>
                                    <li><hr class="dropdown-divider border-secondary" /></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">خروج از حساب</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-faradid">ورود با Irres Gate</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container-fluid px-lg-5 pt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: rgba(16, 185, 129, 0.15); border-color: #10b981; color: #a7f3d0;">
                    <strong>عملیات موفق:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container-fluid px-lg-5 pt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background-color: rgba(239, 68, 68, 0.15); border-color: #ef4444; color: #fca5a5;">
                    <strong>خطا:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-faradid">
        <div class="container-fluid px-lg-5">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <div><strong>فَرادید (Faradid)</strong> | سامانه جامع دیده‌بانی سئو، ممیزی کدهای محلی و تحلیل داده‌های سرچ کنسول</div>
                    <div style="font-size: 11px; margin-top: 4px;">طراحی و پیاده‌سازی شده بر بستر ASP.NET Core 10 | راهکار الکترونیک سهند</div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-secondary">نسخه ۱.۰.۰ سازمانی (.NET 10)</span>
                    <span class="badge bg-primary ms-2">faradid.irres.ir</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
